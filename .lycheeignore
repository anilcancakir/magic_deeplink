# URL patterns lychee skips when checking links in doc/, llms.txt and *.md.
# Every line is a REGULAR EXPRESSION, not a glob.
#
# Add a host here only when it is auth-walled, rate-limited, or a placeholder in
# a code sample. Real rot belongs in the report, not in this file.

# GitHub auth wall: the login redirect answers with a 404 to an unauthenticated
# CI runner.
^https://github\.com/login

# A private vulnerability report needs a signed-in session.
^https://github\.com/anilcancakir/magic_deeplink/security/advisories/new

# The package pages are published with the docs site; until then they answer 404.
# Added 2026-11-15: remove these lines once the docs site serves /magic/deeplink
# and /magic/docs/deeplink.
^https://anilcancakir\.com/magic/deeplink(?:[/?#]|$)
^https://anilcancakir\.com/magic/docs/deeplink(?:[/?#]|$)

# The notifications and starter pages are published with the docs site; until then
# they answer 404.
# Added 2026-11-15: remove these lines once the docs site serves /magic/notifications,
# /magic/docs/notifications, /magic/starter and /magic/docs/starter.
^https://anilcancakir\.com/magic/notifications(?:[/?#]|$)
^https://anilcancakir\.com/magic/docs/notifications(?:[/?#]|$)
^https://anilcancakir\.com/magic/starter(?:[/?#]|$)
^https://anilcancakir\.com/magic/docs/starter(?:[/?#]|$)

# Placeholder hosts inside example code.
^https?://([a-z0-9-]+\.)*example\.com
^https?://localhost
^https?://127\.0\.0\.1
